# Supabase (global leaderboard). Both are safe to expose to the browser — security is enforced by RLS + submit_score().
# Leave blank to run with the local-only (localStorage) leaderboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: canonical URL for Open Graph / Twitter cards
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
